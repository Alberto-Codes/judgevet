          ],
          "properties": {
            "noul": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Probability that the statement is true, from 0 to 1."
            },
            "model": {
              "type": "string",
              "description": "Model identifier the service resolved."
            },
            "usage": {
              "type": "object",
              "description": "Token counts the service reported. An unknown count is null.",
              "required": [
