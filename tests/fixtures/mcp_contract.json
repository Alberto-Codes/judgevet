      {
        "name": "ask_score",
        "title": "Ask a scored judgment",
        "description": "Ask a scored question. Takes a state (text or JSON) and an instruction, returns the ScoreAnswer with score, confidence, legend, and probabilities. Pass criteria that match the question, for example urgency levels ending in \"Critical\". The default [\"Poor\", \"Fair\", \"Good\", \"Excellent\"] is a generic quality rubric.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "state": {
              "type": [
                "string",
                "object"
              ],
              "description": "The content to evaluate. Can be plain text or a JSON object."
            },
            "instruction": {
              "type": "string",
              "description": "The scored question or statement to evaluate about the state."
            },
            "criteria": {
              "type": "array",
              "description": "Ordered levels, lowest first, of the property the question asks about. For urgency: [\"Not urgent\", \"Low\", \"Medium\", \"High\", \"Critical\"]. If omitted, defaults to the generic quality rubric [\"Poor\", \"Fair\", \"Good\", \"Excellent\"]."
            }
          },
          "required": [
            "state",
            "instruction"
          ],
          "additionalProperties": false
        },
        "execution": null,
        "outputSchema": {
          "type": "object",
          "required": [
            "score",
            "confidence",
            "legend",
            "probabilities",
            "default_criteria",
            "model",
            "usage"
          ],
          "properties": {
            "score": {
              "type": "number",
              "description": "Expected level index, weighted by probability, against legend."
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Confidence in the score."
            },
            "legend": {
              "type": "object",
              "description": "Level label keyed by level index, as a string key.",
              "additionalProperties": {
                "type": "string"
              }
            },
            "probabilities": {
              "type": "object",
              "description": "Probability of each level, keyed by level index.",
              "additionalProperties": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "default_criteria": {
              "type": "boolean",
              "description": "True when the call omitted criteria and the server applied the default [\"Poor\", \"Fair\", \"Good\", \"Excellent\"]. False when the caller supplied criteria."
            },
            "model": {
              "type": "string",
              "description": "Model identifier the service resolved."
            },
            "usage": {
              "type": "object",
              "description": "Token counts the service reported. An unknown count is null.",
              "required": [
                "input_tokens",
                "output_tokens"
              ],
              "properties": {
                "input_tokens": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0,
                  "description": "Input tokens used."
                },
                "output_tokens": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0,
                  "description": "Output tokens used."
                }
